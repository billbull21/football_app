<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FootballApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- System bars. -->
        <!-- Ensure the app draws an opaque status bar (helps with edge-to-edge enforcement on newer Android versions). -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/purple_700</item>
        <!-- Use light status bar icons because the background is dark purple. -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Opt out of forced edge-to-edge on API 35+ so statusBarColor is respected. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <!-- Customize your theme here. -->
    </style>
</resources>